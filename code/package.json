{
  "name": "trec-rag-2026-agentic-rag-baseline",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ts": "tsx --test tests/*.test.ts",
    "test:rag": "npm --prefix rag run check",
    "test:python": "python3 -m unittest discover -s tools/tests -p 'test_*.py'",
    "check": "npm run typecheck && npm run test:ts && npm run test:rag && npm run test:python",
    "run:final": "tsx config/final_pipeline.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "tsx": "^4.20.6",
    "typebox": "^1.3.9"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
